rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function userDocExists(uid) {
      return exists(/databases/$(database)/documents/users/$(uid));
    }

    function roleIs(roleName) {
      return signedIn()
        && userDocExists(request.auth.uid)
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == roleName;
    }

    function isAdmin() {
      return roleIs('admin');
    }

    function isSeller() {
      return roleIs('seller');
    }

    match /users/{uid} {
      allow read: if isSelf(uid) || isAdmin();

      // Client-created profiles cannot assign a role or privileged fields.
      allow create: if isSelf(uid)
        && request.resource.data.keys().hasOnly([
          'displayName', 'email', 'photoUrl', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.displayName is string
        && request.resource.data.email is string;

      // User can update only profile fields; role and permissions are immutable from clients.
      allow update: if isSelf(uid)
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['displayName', 'email', 'photoUrl', 'updatedAt']);

      allow delete: if false;

      match /cart/{productId} {
        allow read: if isSelf(uid) || isAdmin();
        allow create, update: if isSelf(uid)
          && request.resource.data.keys().hasOnly(['productId', 'quantity', 'variant', 'updatedAt'])
          && request.resource.data.productId == productId
          && request.resource.data.quantity is int
          && request.resource.data.quantity >= 1
          && request.resource.data.quantity <= 99;
        allow delete: if isSelf(uid) || isAdmin();
      }

      match /wishlist/{productId} {
        allow read, write: if isSelf(uid);
      }

      match /addresses/{addressId} {
        allow read, write: if isSelf(uid);
      }
    }

    match /products/{productId} {
      allow read: if resource.data.isActive == true || isAdmin()
        || (isSeller() && resource.data.sellerId == request.auth.uid);

      allow create: if isAdmin()
        || (isSeller()
          && request.resource.data.sellerId == request.auth.uid
          && request.resource.data.isActive == false
          && request.resource.data.price is number
          && request.resource.data.price >= 0
          && request.resource.data.mrp is number
          && request.resource.data.mrp >= request.resource.data.price
          && request.resource.data.stock is int
          && request.resource.data.stock >= 0);

      allow update: if isAdmin()
        || (isSeller()
          && resource.data.sellerId == request.auth.uid
          && request.resource.data.sellerId == resource.data.sellerId
          && request.resource.data.isActive == resource.data.isActive
          && request.resource.data.price is number
          && request.resource.data.price >= 0
          && request.resource.data.mrp is number
          && request.resource.data.mrp >= request.resource.data.price
          && request.resource.data.stock is int
          && request.resource.data.stock >= 0);

      allow delete: if isAdmin();
    }

    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /banners/{bannerId} {
      allow read: if resource.data.isActive == true || isAdmin();
      allow write: if isAdmin();
    }

    // Orders and payout balances must be changed by trusted backend/admin only.
    match /orders/{orderId} {
      allow read: if isAdmin()
        || (signedIn() && resource.data.customerId == request.auth.uid)
        || (isSeller() && resource.data.sellerIds is list
          && request.auth.uid in resource.data.sellerIds);
      allow write: if isAdmin();
    }

    match /sellers/{sellerId} {
      allow read: if isSelf(sellerId) || isAdmin();
      allow create, update, delete: if isAdmin();
    }

    match /wallets/{sellerId} {
      allow read: if isSelf(sellerId) || isAdmin();
      allow write: if isAdmin();
    }

    match /payoutRequests/{requestId} {
      allow read: if isAdmin()
        || (signedIn() && resource.data.sellerId == request.auth.uid);
      allow create, update, delete: if isAdmin();
    }

    match /reviews/{reviewId} {
      allow read: if resource.data.isVisible == true || isAdmin();
      // Review creation should be implemented in a trusted flow that verifies a delivered order.
      allow create, update, delete: if isAdmin();
    }

    match /notifications/{notificationId} {
      allow read: if signedIn() && resource.data.userId == request.auth.uid;
      allow write: if isAdmin();
    }

    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Explicitly deny all paths not covered above.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
